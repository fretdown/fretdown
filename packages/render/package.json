{
	"name": "@fretdown/render",
	"version": "0.1.0",
	"description": "Fretdown VexFlow → SVG renderer",
	"type": "module",
	"license": "MIT",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run --passWithNoTests",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@fretdown/core": "workspace:*",
		"jsdom": "^25.0.1",
		"vexflow": "^4.2.5"
	},
	"devDependencies": {
		"@types/jsdom": "^21.1.7",
		"tsup": "^8.3.5",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	}
}
